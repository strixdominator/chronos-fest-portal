# ===============================================================
# SUPABASE DATABASE (LIVE PERSISTENT STORAGE)
# ===============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_KEY=sb_secret_...


# ---------------------------------------------------------------
# OPTION A: BREVO API (RECOMMENDED FOR RENDER FREE TIER - 100% FREE)
# ---------------------------------------------------------------
# Render Free Tier blocks outbound SMTP ports (465/587).
# Brevo uses HTTPS (Port 443), which is NEVER blocked by Render!
# Gives 300 FREE emails every day to ANY recipient.
# Step 1: Sign up free at https://www.brevo.com
# Step 2: Go to https://app.brevo.com/settings/keys/api and click "Generate a new API key"
# Step 3: Add to Render Dashboard -> Environment:
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_SENDER=your-registered-gmail@gmail.com

# ---------------------------------------------------------------
# OPTION B: RESEND API (ALTERNATIVE FOR RENDER - 100% FREE)
# ---------------------------------------------------------------
# Free 3,000 emails/month via HTTPS Port 443.
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here
RESEND_FROM=MILAN 2026 <onboarding@resend.dev>

# ---------------------------------------------------------------
# OPTION C: GMAIL SMTP (LOCAL DEVELOPMENT / PAID VPS ONLY)
# ---------------------------------------------------------------
# Works on localhost, but Render Free Tier blocks ports 465/587.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ---------------------------------------------------------------
# OPTION 1: FAST2SMS WHATSAPP & OTP (EASIEST FOR INDIA - RECHARGE VIA UPI)
# ---------------------------------------------------------------
# Step 1: Sign up at https://www.fast2sms.com and add ₹100 via UPI
# Step 2: Copy API Key from "Dev API" section
# Step 3: (For WhatsApp) Go to WhatsApp section -> create template & link number
FAST2SMS_API_KEY=
FAST2SMS_WA_MESSAGE_ID=
FAST2SMS_WA_PHONE_NUMBER_ID=

# ---------------------------------------------------------------
# OPTION 2: OFFICIAL META WHATSAPP BUSINESS CLOUD API
# ---------------------------------------------------------------
# 1,000 FREE service conversations every month directly from Meta
# Step 1: Create Business App at https://developers.facebook.com
# Step 2: Under WhatsApp -> API Setup, copy Phone number ID
# Step 3: Under Business Settings -> System Users, generate non-expiring token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=milan_pass_otp
WHATSAPP_LANGUAGE_CODE=en_US

# ---------------------------------------------------------------
# SMS OTP (GLOBAL - Twilio) - OPTIONAL
# ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------
# SECURITY PIN CONFIGURATION
# ---------------------------------------------------------------
ADMIN_PASSCODE="alumni#milan"
SCANNER_PIN="milan#entry"

