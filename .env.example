# ===============================================================
# CHRONOS FEST '26 - ENVIRONMENT CONFIGURATION
# ===============================================================

# ---------------------------------------------------------------
# OPTION A: BREVO API (RECOMMENDED FOR RENDER FREE TIER - 100% FREE)
# ---------------------------------------------------------------
# Render Free Tier blocks outbound SMTP ports (465/587).
# Brevo uses HTTPS (Port 443), which is NEVER blocked by Render!
# Gives 300 FREE emails every day to ANY recipient.
# Step 1: Sign up free at https://www.brevo.com
# Step 2: Go to https://app.brevo.com/settings/keys/api and click "Generate a new API key"
# Step 3: Add to Render Dashboard -> Environment:
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_SENDER=your-registered-gmail@gmail.com

# ---------------------------------------------------------------
# OPTION B: RESEND API (ALTERNATIVE FOR RENDER - 100% FREE)
# ---------------------------------------------------------------
# Free 3,000 emails/month via HTTPS Port 443.
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here
RESEND_FROM=MILAN 2026 <onboarding@resend.dev>

# ---------------------------------------------------------------
# OPTION C: GMAIL SMTP (LOCAL DEVELOPMENT / PAID VPS ONLY)
# ---------------------------------------------------------------
# Works on localhost, but Render Free Tier blocks ports 465/587.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ---------------------------------------------------------------
# SMS OTP (INDIA - Fast2SMS) - OPTIONAL (~₹0.20 / SMS)
# ---------------------------------------------------------------
FAST2SMS_API_KEY=

# ---------------------------------------------------------------
# SMS OTP (GLOBAL - Twilio) - OPTIONAL
# ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
